# Twice a day, at 02:30 and 14:30 UTC; a run missed while the server was off runs at boot.
# Two runs keep a complete backup inside every 24-hour window of alert-backup-missing-blobs,
# whichever hour Azure evaluates it (see docs/hosting/upcloud-results.md, Findings 2026-10-20).
[Unit]
Description=Bike Log twice-daily backup

[Timer]
OnCalendar=*-*-* 02:30:00 UTC
OnCalendar=*-*-* 14:30:00 UTC
Persistent=true
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
