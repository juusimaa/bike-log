# /srv/bikelog/secrets/api.env (root, 0600): the API, migration and operator
# connection string, copied unchanged from the Key Vault secret
# api-postgres-connection. It must keep SSL Mode=VerifyFull,
# Root Certificate=/mnt/secrets/aiven-ca-certificate and the Maximum Pool Size cap
# from the Azure secret (Aiven allows 20 connections). Placeholders only.
ConnectionStrings__Postgres=Host=<aiven host>;Port=<port>;Database=defaultdb;Username=<user>;Password=<password>;SSL Mode=VerifyFull;Root Certificate=/mnt/secrets/aiven-ca-certificate;GSS Encryption Mode=Disable;Maximum Pool Size=3;Timeout=15
