# /srv/bikelog/secrets/backup.env (root, 0600): the daily backup job.
# BIKELOG_DATABASE_URL is the Key Vault secret backup-database-url. The Azure values
# identify the "Bike Log backup (UpCloud)" app registration, which signs in with
# the certificate in secrets/backup-client.pem. Placeholders only.
BIKELOG_DATABASE_URL=postgresql://<user>:<password>@<aiven host>:<port>/defaultdb?sslmode=verify-full&sslrootcert=/mnt/secrets/aiven-ca-certificate
AZURE_TENANT_ID=<tenant id>
AZURE_CLIENT_ID=<backup app registration client id>
AZURE_CLIENT_CERTIFICATE_FILE=/mnt/secrets/backup-client.pem
BACKUP_ACCOUNT_URL=https://<storage account>.blob.core.windows.net
BACKUP_CONTAINER=backups
