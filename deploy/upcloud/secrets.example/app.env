# /srv/bikelog/secrets/app.env (root, 0600): the web app's secrets.
# Values come from the Key Vault secrets auth0-client-secret, web-database-url and
# web-session-key. Placeholders only; never commit a real value.
AUTH0_CLIENT_SECRET=<auth0 client secret>
# TLS verification comes from BIKELOG_DATABASE_CA_FILE, set in compose.yaml.
BIKELOG_WEB_DATABASE_URL=postgresql://<user>:<password>@<aiven host>:<port>/defaultdb
BIKELOG_SESSION_KEY=<session key>
