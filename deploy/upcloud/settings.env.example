# Copy to /srv/bikelog/settings.env (root, 0644). Non-secret settings only; secrets
# go in secrets/ (see secrets.example/). Read by bikelog-deploy for Compose
# interpolation, never printed.
WEB_PUBLIC_ORIGIN=https://<server hostname>
AUTH0_ISSUER=https://<auth0 tenant>/
AUTH0_AUDIENCE=<auth0 api audience>
AUTH0_CLIENT_ID=<auth0 hosted application client id>
# Checked by the operator commands before they write (spec 004, research D6).
Operator__HostedDatabaseHost=<aiven host>
# Only if Caddy's Docker network is not called "caddy".
#CADDY_NETWORK=caddy
