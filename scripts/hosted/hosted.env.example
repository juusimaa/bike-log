# Copy to .local/hosted.env; never commit real values.
# scripts/hosted/hosted.sh and restore-rehearsal.sh refuse to run while any
# value below still contains "<".
AZURE_SUBSCRIPTION_ID=<subscription id>
AZURE_RESOURCE_GROUP=rg-bikelog-prod
# Backup storage account name: the storageAccountName output of infra/backup.bicep.
BACKUP_STORAGE_ACCOUNT=<storage account name>
